rules_version = '2';

// ทริปที่แชร์: เข้าได้เฉพาะสมาชิก · เจ้าของเชิญด้วยอีเมล · ผู้ได้รับเชิญเพิ่มตัวเองเข้าเป็นสมาชิกได้เท่านั้น
// ของส่วนตัว (users/{uid}) เข้าได้เฉพาะเจ้าของบัญชี
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true
        ? request.auth.token.email.lower() : '';
    }
    function tripDoc(t) { return get(/databases/$(database)/documents/trips/$(t)); }
    function isMember(t) { return signedIn() && request.auth.uid in tripDoc(t).data.memberUids; }
    function isOwnerOf(t) { return signedIn() && tripDoc(t).data.ownerUid == request.auth.uid; }
    function smallString(v, n) { return v is string && v.size() <= n; }

    match /trips/{t} {
      // อ่าน: สมาชิก หรือ คนที่อีเมลอยู่ในรายชื่อเชิญ (ใช้ค้นทริปที่ได้รับเชิญ)
      allow read: if signedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (myEmail() != '' && myEmail() in resource.data.invites)
      );
      // สร้าง: ผู้สร้างเป็นเจ้าของและสมาชิกคนเดียว
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.invites is list && request.resource.data.invites.size() <= 30
        && smallString(request.resource.data.name, 80)
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);
      // แก้: เจ้าของแก้ได้ (ยกเว้นเปลี่ยนเจ้าของ) · สมาชิกแก้ชื่อทริปได้ ·
      //      ผู้ได้รับเชิญเพิ่ม "ตัวเอง" เข้า memberUids/members และเอาอีเมลตัวเองออกจาก invites เท่านั้น ·
      //      สมาชิกออกจากทริปเองได้ (เอาตัวเองออก)
      allow update: if signedIn() && request.resource.data.ownerUid == resource.data.ownerUid && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid in request.resource.data.memberUids
          && request.resource.data.invites.size() <= 30)
        || (request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
          && smallString(request.resource.data.name, 80))
        || (myEmail() != '' && myEmail() in resource.data.invites
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'invites', 'updatedAt'])
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.invites.toSet() == resource.data.invites.toSet().difference([myEmail()].toSet()))
        || (request.auth.uid in resource.data.memberUids && request.auth.uid != resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'updatedAt'])
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.members))
      );
      allow delete: if isOwnerOf(t);

      // วันในแผน: สมาชิกอ่าน/เขียนได้ · ลบวันได้เฉพาะเจ้าของ
      match /days/{d} {
        allow read: if isMember(t);
        allow create, update: if isMember(t) && request.resource.data.day is map;
        allow delete: if isOwnerOf(t);
      }
      // สถานที่ที่เพิ่มเอง: สมาชิกอ่าน/เพิ่ม/แก้/ลบได้
      match /places/{p} {
        allow read, delete: if isMember(t);
        allow create, update: if isMember(t) && smallString(request.resource.data.nameTh, 120);
      }
      // รูปของสถานที่ (base64 ย่อแล้ว)
      match /photos/{ph} {
        allow read, delete: if isMember(t);
        allow create, update: if isMember(t) && request.resource.data.d is string && request.resource.data.d.size() < 900000;
      }
      // ค่าที่ใช้ร่วม: ลำดับวัน (เจ้าของ) และค่าที่ปรับ (สมาชิก)
      match /meta/{m} {
        allow read: if isMember(t);
        allow write: if m == 'overrides' ? isMember(t) : isOwnerOf(t);
      }
    }

    // ของส่วนตัวของแต่ละบัญชี
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
